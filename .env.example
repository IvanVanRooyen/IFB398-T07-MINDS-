# Local development only. Replace the placeholder secrets before starting.
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1

# Compose database and Django connection; keep these values aligned.
POSTGRES_DB=minds
POSTGRES_USER=minds
POSTGRES_PASSWORD=replace-with-a-local-database-password
DB_NAME=minds
DB_USER=minds
DB_PASS=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0

# S3-compatible document storage
MINIO_ROOT_USER=minds-local
MINIO_ROOT_PASSWORD=replace-with-a-local-storage-password
MINIO_BUCKET=documents
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=0

# Optional AI drafting; manual outlines do not call this service.
GRANITE_BACKEND=ollama
GRANITE_MODEL=granite3.2:8b-instruct-fp16
OLLAMA_URL=http://host.docker.internal:11434
GRANITE_TIMEOUT=120
REPORT_JOB_LEASE_SECONDS=600

# Required by the historical database-reader migration.
GF_PG_READER_USER=minds_grafana
GF_PG_READER_PASS=replace-with-a-local-reader-password
