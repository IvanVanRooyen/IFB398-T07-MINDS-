# Local development only. Replace the password/key placeholders.
# compose.dev.yml runs private filesystem storage and publishes only localhost:8000.
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=minds_dev
POSTGRES_USER=minds
POSTGRES_PASSWORD=replace-with-a-local-database-password
GF_PG_READER_USER=minds_grafana
GF_PG_READER_PASS=replace-with-a-local-reader-password
# Used only to create the two non-admin synthetic accounts; minimum 12 characters.
DEMO_PASSWORD=replace-with-a-local-demo-password

# Optional model service. Manual outlines do not call it.
GRANITE_BACKEND=ollama
GRANITE_MODEL=granite3.2:8b-instruct-fp16
OLLAMA_URL=http://host.docker.internal:11434
GRANITE_TIMEOUT=120
REPORT_JOB_LEASE_SECONDS=600

# Optional native/legacy configuration; the supported local Compose profile derives
# its database connection from POSTGRES_* and does not require object storage.
DJANGO_DEBUG=1
DB_NAME=minds_dev
DB_USER=minds
DB_PASS=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=minds-local
MINIO_ROOT_PASSWORD=replace-with-a-local-storage-password
MINIO_BUCKET=documents
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=0
